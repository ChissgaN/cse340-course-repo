# Copy this file to .env for local development.
# The real .env is ignored by Git and must never be committed.

PORT=3000
NODE_ENV=development

# PostgreSQL connection string.
# Locally: the External Database URL from the Render database dashboard.
# On Render: the Internal Database URL (faster, stays inside Render's network).
# Format: postgresql://user:password@host/database
DB_URL=postgresql://user:password@host/database

# Log every SQL query with its duration. Only active when NODE_ENV=development.
ENABLE_SQL_LOGGING=true
