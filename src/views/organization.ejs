<%- include('partials/header') %>

<section class="page-intro">
  <h1><%= title %></h1>
</section>

<section class="section">
  <article class="card org-card">
    <img class="org-logo" src="/images/<%= organizationDetails.logo_filename %>"
         alt="Logo of <%= organizationDetails.name %>">
    <h2><%= organizationDetails.name %></h2>
    <p><%= organizationDetails.description %></p>
    <p class="meta">
      <a href="mailto:<%= organizationDetails.contact_email %>"><%= organizationDetails.contact_email %></a>
    </p>
  </article>
</section>

<section class="section">
  <h2>Service Projects</h2>

  <% if (projects.length === 0) { %>
    <p>This organization has no service projects scheduled right now.</p>
  <% } else { %>
    <ul class="project-list">
      <% projects.forEach((project) => { %>
        <%
          const projectDate = project.project_date.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          });
        %>
        <li>
          <a href="/project/<%= project.project_id %>"><%= project.title %></a>
          &mdash; <%= projectDate %>, <%= project.location %>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<p><a href="/organizations">Back to all organizations</a></p>

<%- include('partials/footer') %>
