<%- include('partials/header') %>

<section class="page-intro">
  <h1><%= title %></h1>
  <p class="lead">
    Add a partner organization to the network. New organizations use a placeholder logo.
  </p>
</section>

<section class="section">
  <form class="card form" action="/new-organization" method="POST">
    <div class="form-group">
      <label for="name">Organization Name</label>
      <input
        type="text"
        id="name"
        name="name"
      />
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea
        id="description"
        name="description"
        rows="5"
      ></textarea>
    </div>

    <div class="form-group">
      <label for="contactEmail">Contact Email</label>
      <input
        type="text"
        id="contactEmail"
        name="contactEmail"
      />
    </div>

    <button class="button" type="submit">Create Organization</button>
  </form>
</section>

<p><a href="/organizations">Back to all organizations</a></p>

<%- include('partials/footer') %>
