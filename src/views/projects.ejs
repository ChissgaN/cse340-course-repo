<%- include('partials/header') %>

<section class="page-intro">
  <h1><%= title %></h1>
  <p class="lead">
    The next service projects our partner organizations have scheduled. Choose the one
    that fits your schedule and interests.
  </p>
</section>

<section class="section">
  <div class="card-grid">
    <% projects.forEach((project) => { %>
      <%
        // The database returns a Date object, so format it as "October 3, 2026".
        const projectDate = project.project_date.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        });
      %>
      <article class="card">
        <h2>
          <%= projectDate %>:
          <a href="/project/<%= project.project_id %>"><%= project.title %></a>
        </h2>
        <p><%= project.description %></p>
        <p class="meta">
          Location: <%= project.location %><br>
          Organized by
          <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
        </p>
      </article>
    <% }) %>
  </div>
</section>

<%- include('partials/footer') %>
