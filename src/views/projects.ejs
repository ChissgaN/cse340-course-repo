<%- include('partials/header') %>

<section class="page-intro">
  <h1><%= title %></h1>
  <p class="lead">
    Every project below is organized by one of our partner organizations and is open to
    new volunteers. Choose the one that fits your schedule and interests.
  </p>
</section>

<section class="section">
  <div class="card-grid">
    <% projects.forEach((project) => { %>
      <article class="card">
        <h2><%= project.name %></h2>
        <p class="tag"><%= project.category %></p>
        <p><%= project.description %></p>
        <p class="meta">Organized by <%= project.organization %></p>
      </article>
    <% }) %>
  </div>
</section>

<%- include('partials/footer') %>
