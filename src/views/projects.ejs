<%- include('partials/header') %>

<section class="page-intro">
  <h1><%= title %></h1>
  <p class="lead">
    Every project below is organized by one of our partner organizations and is open to
    new volunteers. Choose the one that fits your schedule and interests.
  </p>
</section>

<section class="section">
  <div class="card-grid">
    <% projects.forEach((project) => { %>
      <%
        // The database returns a Date object, so format it as "October 3, 2026".
        const projectDate = project.project_date.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        });
      %>
      <article class="card">
        <h2><%= projectDate %>: <%= project.title %> (<%= project.organization_name %>)</h2>
        <p><%= project.description %></p>
        <p class="meta">Location: <%= project.location %></p>
      </article>
    <% }) %>
  </div>
</section>

<%- include('partials/footer') %>
