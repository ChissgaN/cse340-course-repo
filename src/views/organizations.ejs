<%- include('partials/header') %>

<section class="page-intro">
  <h1><%= title %></h1>
  <p class="lead">
    These are the organizations that coordinate service projects through the CSE 340
    Service Network. Each one focuses on a different community need.
  </p>
</section>

<section class="section">
  <div class="card-grid">
    <% organizations.forEach((organization) => { %>
      <article class="card org-card">
        <img class="org-logo" src="/images/<%= organization.logo_filename %>"
             alt="Logo of <%= organization.name %>">
        <h2><%= organization.name %></h2>
        <p><%= organization.description %></p>
        <p class="meta">
          <a href="mailto:<%= organization.contact_email %>"><%= organization.contact_email %></a>
        </p>
      </article>
    <% }) %>
  </div>
</section>

<%- include('partials/footer') %>
