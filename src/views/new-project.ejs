<%- include('partials/header') %>

<section class="page-intro">
  <h1><%= title %></h1>
  <p class="lead">
    Add a service project and choose the partner organization that sponsors it.
  </p>
</section>

<section class="section">
  <form class="card form" action="/new-project" method="POST">
    <div class="form-group">
      <label for="title">Project Title</label>
      <input
        type="text"
        id="title"
        name="title"
        minlength="3"
        maxlength="200"
        required
      />
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea
        id="description"
        name="description"
        rows="5"
        maxlength="1000"
        required
      ></textarea>
    </div>

    <div class="form-group">
      <label for="location">Location</label>
      <input
        type="text"
        id="location"
        name="location"
        maxlength="200"
        required
      />
    </div>

    <div class="form-group">
      <label for="date">Date</label>
      <input
        type="date"
        id="date"
        name="date"
        required
      />
    </div>

    <div class="form-group">
      <label for="organizationId">Sponsoring Organization</label>
      <select id="organizationId" name="organizationId" required>
        <option value="">Choose an organization</option>
        <% organizations.forEach((organization) => { %>
          <option value="<%= organization.organization_id %>"><%= organization.name %></option>
        <% }) %>
      </select>
    </div>

    <button class="button" type="submit">Create Service Project</button>
  </form>
</section>

<p><a href="/projects">Back to upcoming service projects</a></p>

<%- include('partials/footer') %>
