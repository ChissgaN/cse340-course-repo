<%- include('partials/header') %>

<section class="page-intro">
  <h1><%= title %></h1>
  <p class="lead">
    Categories group the service projects by the kind of work they involve. A project can
    belong to more than one category.
  </p>
</section>

<section class="section">
  <div class="card-grid">
    <% categories.forEach((category) => { %>
      <article class="card">
        <h2><%= category.name %></h2>
      </article>
    <% }) %>
  </div>
</section>

<%- include('partials/footer') %>
