<%- include('partials/header') %>

<%
  const projectDate = project.project_date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
%>

<section class="page-intro">
  <h1><%= title %></h1>
</section>

<section class="section">
  <article class="card">
    <h2><%= project.title %></h2>

    <% if (categories.length > 0) { %>
      <ul class="tag-list" aria-label="Categories">
        <% categories.forEach((category) => { %>
          <li>
            <a class="tag" href="/category/<%= category.category_id %>"><%= category.name %></a>
          </li>
        <% }) %>
      </ul>
    <% } %>

    <p><%= project.description %></p>

    <dl class="project-facts">
      <dt>Date</dt>
      <dd><%= projectDate %></dd>

      <dt>Location</dt>
      <dd><%= project.location %></dd>

      <dt>Organized by</dt>
      <dd>
        <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
      </dd>
    </dl>
  </article>
</section>

<p><a href="/projects">Back to upcoming service projects</a></p>

<%- include('partials/footer') %>
